# Required by the default clinical model configuration.
OAI_KEY=

# Recommended for PubMed/NCBI Entrez identification.
NCBI_EMAIL=
# Optional; increases NCBI API rate limits when available.
NCBI_API_KEY=

# Comma-separated browser origins allowed by the clinical API.
MEDDX_ALLOWED_ORIGINS=http://localhost:5173,https://meddxagentfrontend.vercel.app

# Production database. A postgres:// or postgresql:// URL enables shared
# sessions, authenticated cases and database-backed rate-limit coordination.
# MEDDX_DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_URL may be used instead when supplied by the hosting platform.

# SQLite fallback used when no database URL is configured.
# Point this at persistent storage in production if SQLite remains enabled.
# MEDDX_SESSION_DB_PATH=/data/clinical_sessions.sqlite3

# Authentication is disabled by default so existing clinical traffic is not
# broken before an identity provider is connected. Server-side case storage
# still requires an authenticated identity.
# MEDDX_AUTH_MODE=disabled
# Supported: disabled, shared-token, oidc-jwt
# MEDDX_AUTH_REQUIRED_ROLES=clinician,admin
# Development/staging shared-token mode only:
# MEDDX_AUTH_SHARED_TOKEN=
# MEDDX_AUTH_SHARED_SUBJECT=service-user
# MEDDX_AUTH_SHARED_ROLES=clinician
# Generic OIDC/JWKS mode (suitable for a future auth provider connection):
# MEDDX_AUTH_ISSUER=
# MEDDX_AUTH_AUDIENCE=
# MEDDX_AUTH_JWKS_URL=
# MEDDX_AUTH_ROLES_CLAIM=roles
# MEDDX_AUTH_JWT_ALGORITHMS=RS256,ES256

# Session lifecycle. TTL 0 preserves no-expiry behavior until a retention
# policy is approved. Once enabled, successful mutations refresh the TTL.
# MEDDX_SESSION_TTL_HOURS=0
# MEDDX_SESSION_CLEANUP_INTERVAL_SECONDS=300

# Structured clinical API logging. INFO is the production default.
# MEDDX_LOG_LEVEL=INFO
# Optional JSONL mirror for privacy-filtered audit/monitoring events.
# MEDDX_AUDIT_LOG_PATH=/data/clinical_audit.jsonl
# Optional sanitized error-event webhook. Must be HTTPS.
# MEDDX_MONITORING_WEBHOOK_URL=https://monitoring.example/hooks/meddx
# MEDDX_MONITORING_TIMEOUT_SECONDS=3
# MEDDX_MONITORING_MIN_LEVEL=ERROR

# Public API hardening defaults. Set a rate limit to 0 only for isolated testing.
# auto = memory for SQLite, database-coordinated for Postgres.
# MEDDX_RATE_LIMIT_BACKEND=auto
# MEDDX_RATE_LIMIT_REQUESTS_PER_MINUTE=240
# MEDDX_RATE_LIMIT_SESSION_CREATES_PER_MINUTE=30
# MEDDX_RATE_LIMIT_MODEL_ACTIONS_PER_MINUTE=30
# MEDDX_RATE_LIMIT_MAX_KEYS=10000
# MEDDX_MAX_BODY_BYTES=65536
# MEDDX_MAX_HEADER_BYTES=16384
# MEDDX_MAX_PATIENT_INFO_CHARS=32000
# MEDDX_MAX_ANSWER_CHARS=8000
# MEDDX_MAX_PATIENT_ID_CHARS=128
# MEDDX_MAX_CASE_ID_CHARS=128
# MEDDX_BODY_TIMEOUT_SECONDS=30
# MEDDX_IDLE_CONNECTION_TIMEOUT_SECONDS=60

# Hosting platforms normally provide PORT automatically.
PORT=8000

# Optional path to a custom clinical YAML config.
# MEDDX_CLINICAL_CONFIG=/path/to/clinical.yml
