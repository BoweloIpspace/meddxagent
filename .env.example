# Required by the default clinical model configuration.
OAI_KEY=

# Recommended for PubMed/NCBI Entrez identification.
NCBI_EMAIL=
# Optional; increases NCBI API rate limits when available.
NCBI_API_KEY=

# Comma-separated browser origins allowed by the clinical API.
MEDDX_ALLOWED_ORIGINS=http://localhost:5173,https://meddxagentfrontend.vercel.app

# Optional SQLite file used to resume clinical sessions after process restarts.
# Point this at persistent storage in production when available.
# MEDDX_SESSION_DB_PATH=/data/clinical_sessions.sqlite3

# Structured clinical API logging. INFO is the production default.
# MEDDX_LOG_LEVEL=INFO
# Optional JSONL mirror for privacy-filtered audit/monitoring events.
# MEDDX_AUDIT_LOG_PATH=/data/clinical_audit.jsonl

# Public API hardening defaults. Set a rate limit to 0 only for isolated testing.
# MEDDX_RATE_LIMIT_REQUESTS_PER_MINUTE=240
# MEDDX_RATE_LIMIT_SESSION_CREATES_PER_MINUTE=30
# MEDDX_RATE_LIMIT_MODEL_ACTIONS_PER_MINUTE=30
# MEDDX_RATE_LIMIT_MAX_KEYS=10000
# MEDDX_MAX_BODY_BYTES=65536
# MEDDX_MAX_HEADER_BYTES=16384
# MEDDX_MAX_PATIENT_INFO_CHARS=32000
# MEDDX_MAX_ANSWER_CHARS=8000
# MEDDX_MAX_PATIENT_ID_CHARS=128
# MEDDX_BODY_TIMEOUT_SECONDS=30
# MEDDX_IDLE_CONNECTION_TIMEOUT_SECONDS=60

# Hosting platforms normally provide PORT automatically.
PORT=8000

# Optional path to a custom clinical YAML config.
# MEDDX_CLINICAL_CONFIG=/path/to/clinical.yml
