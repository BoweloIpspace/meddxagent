# Required by the default clinical model configuration.
OAI_KEY=

# Recommended for PubMed/NCBI Entrez identification.
NCBI_EMAIL=
# Optional; increases NCBI API rate limits when available.
NCBI_API_KEY=

# Comma-separated browser origins allowed by the clinical API.
MEDDX_ALLOWED_ORIGINS=http://localhost:5173,https://meddxagentfrontend.vercel.app

# Hosting platforms normally provide PORT automatically.
PORT=8000

# Optional path to a custom clinical YAML config.
# MEDDX_CLINICAL_CONFIG=/path/to/clinical.yml
